{
  "name": "space-tourism-website",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend Mentor space tourism multi-page website.",
  "scripts": {
    "sass": "sass --update scss/style.scss:css/style.css scss/design-system.scss:css/design-system.css --style=expanded --no-source-map",
    "sass:watch": "sass --watch scss/style.scss:css/style.css scss/design-system.scss:css/design-system.css --style=expanded --no-source-map",
    "sass:build": "sass --update scss/style.scss:css/style.css scss/design-system.scss:css/design-system.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.89.0"
  }
}
